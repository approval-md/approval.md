{
  "suite": "jcs-canonicalization",
  "vectors_version": "1.0.0",
  "algorithm": "RFC 8785 (JSON Canonicalization Scheme), as required by `alg: sha256/jcs`",
  "description": "The serialization every digest in SPEC.md §8 is taken over. Two implementations that disagree here agree about nothing else: the hash is over these bytes.",
  "provenance": "Generated by scripts/regen-conformance-vectors.mjs from this repository's own implementation. Inputs are authored by hand; every expectation is computed, never transcribed. See conformance/README.md for the runner contract.",
  "count": 53,
  "vectors": [
    {
      "id": "rfc8785-3.2.3-sorting",
      "description": "RFC 8785 §3.2.3 property sorting: keys emerge in code-unit order regardless of input order",
      "input": {
        "input_json": "{\"\\u20ac\":\"Euro Sign\",\"\\r\":\"Carriage Return\",\"\\ufb33\":\"Hebrew Letter Dalet With Dagesh\",\"1\":\"One\",\"\\ud83d\\ude00\":\"Emoji: Grinning Face\",\"\\u0080\":\"Control\",\"\\u00f6\":\"Latin Small Letter O With Diaeresis\"}"
      },
      "expect": {
        "valid": true,
        "canonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"😀\":\"Emoji: Grinning Face\",\"דּ\":\"Hebrew Letter Dalet With Dagesh\"}",
        "utf8_hex": ""
      }
    },
