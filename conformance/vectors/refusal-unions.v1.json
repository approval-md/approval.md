{
  "suite": "refusal-unions",
  "vectors_version": "1.0.0",
  "algorithm": "SPEC.md §11.1 invariant 6: refusals are machine-readable and distinct",
  "description": "The closed unions of refusal codes. A caller branches on these strings, so adding, removing, or renaming one is a breaking change and shows up here as a diff.",
  "provenance": "Generated by scripts/regen-conformance-vectors.mjs from this repository's own implementation. Inputs are authored by hand; every expectation is computed, never transcribed. See conformance/README.md for the runner contract.",
  "count": 6,
  "vectors": [
    {
      "id": "union-gate_refusal_codes",
      "description": "every way `approval register|request|decide|withdraw|expire` can refuse. Order is definition order; conformance means emitting exactly these codes, no more, no fewer.",
      "input": {
        "union": "gate_refusal_codes"
      },
      "expect": {
        "valid": true,
        "codes": [
          "policy-not-attested",
          "policy-drift",
          "envelope-invalid",
          "task-file-unreadable",
          "task-already-registered",
          "envelope-missing",
          "not-registered",
          "action-not-registered",
          "duplicate-request",
          "already-executed",
          "budget-exceeded",
          "payload-hash-required",
          "payload-mismatch",
          "payload-store-failed",
          "grant-classless-request",
          "loop-escalated",
          "not-requested",
          "already-decided",
          "not-granted",
          "request-withdrawn",
          "not-requester",
          "expired",
          "not-expired",
          "actor-invalid",
          "actor-not-human",
          "log-unreadable",
          "log-torn-tail",
          "log-corrupt",
          "append-failed"
        ]
      }
    },
    {
      "id": "union-token_verify_refusal_codes",
      "description": "every way a presented token can fail verification. Order is definition order; conformance means emitting exactly these codes, no more, no fewer.",
      "input": {
        "union": "token_verify_refusal_codes"
      },
      "expect": {
        "valid": true,
        "codes": [
          "not-granted",
          "token-mismatch",
          "token-consumed",
          "token-expired",
          "token-revoked",
          "payload-mismatch",
          "harness-executed"
        ]
      }
    },
    {
      "id": "union-token_refusal_codes",
      "description": "the token verbs' union: verification plus the log-and-append failures. Order is definition order; conformance means emitting exactly these codes, no more, no fewer.",
      "input": {
        "union": "token_refusal_codes"
      },
      "expect": {
        "valid": true,
        "codes": [
          "not-granted",
          "token-mismatch",
          "token-consumed",
          "token-expired",
          "token-revoked",
          "payload-mismatch",
          "harness-executed",
          "log-unreadable",
          "log-torn-tail",
          "log-corrupt",
          "append-failed"
        ]
      }
    },
    {
      "id": "union-execute_refusal_codes",
      "description": "every way `approval run` and the adapter contract can refuse. Order is definition order; conformance means emitting exactly these codes, no more, no fewer.",
      "input": {
        "union": "execute_refusal_codes"
      },
      "expect": {
        "valid": true,
        "codes": [
          "action-not-registered",
          "token-required",
          "loop-escalated",
          "policy-not-attested",
          "already-executed",
          "budget-exceeded",
          "not-started",
          "already-finished",
          "not-granted",
          "token-mismatch",
          "token-consumed",
          "token-expired",
          "token-revoked",
          "harness-executed",
          "payload-mismatch",
          "actor-not-human",
          "log-unreadable",
          "log-torn-tail",
          "log-corrupt",
          "append-failed"
        ]
      }
    },
    {
      "id": "union-append_error_codes",
      "description": "every way the write boundary itself can refuse an append. Order is definition order; conformance means emitting exactly these codes, no more, no fewer.",
      "input": {
        "union": "append_error_codes"
      },
      "expect": {
        "valid": true,
        "codes": [
          "lock-timeout",
          "corrupt-tail",
          "validation",
          "canonicalization",
          "io",
          "head-moved"
        ]
      }
    },
    {
      "id": "union-unknown",
      "description": "a union name no implementation defines must be refused, not answered with an empty list — an empty union would let a checker report full coverage of nothing",
      "control": true,
      "input": {
        "union": "there_is_no_such_union"
      },
      "expect": {
        "valid": false,
        "failure_class": "unknown-union"
      }
    }
  ]
}
